# Optional: the deterministic crawl works without an LLM.
#
# Any OpenAI-compatible chat/completions endpoint works. Two examples:
#
#   OpenAI
#     LLM_PROVIDER=openai
#     LLM_MODEL=gpt-4o-mini
#     LLM_BASE_URL=https://api.openai.com/v1     (optional for provider=openai)
#
#   Gemini, via Google's OpenAI-compatible endpoint
#     LLM_PROVIDER=gemini
#     LLM_MODEL=gemini-3.6-flash
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Free provider tiers are small. Gemini's free tier allows roughly 5 requests
# per minute and 20 per day per model, so keep llm.shadow_sample low in
# config.yaml unless you have paid quota. The adapter paces requests, retries
# 429 with backoff, and stops sampling once a quota is exhausted.

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
